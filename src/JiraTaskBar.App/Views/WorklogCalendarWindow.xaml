<ui:FluentWindow x:Class="JiraTaskBar.App.Views.WorklogCalendarWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Time calendar"
                 Width="1120" Height="720" MinWidth="760" MinHeight="520"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 Loaded="Window_Loaded" Closed="Window_Closed">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="WindowTitle" Title="Time calendar" />

        <DockPanel Grid.Row="1" Margin="20,8,20,10" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <ui:Button Content="‹" FontSize="22" Padding="10,2" ToolTip="Previous" Click="Previous_Click" />
                <ui:Button Content="Today" Margin="6,0" Click="Today_Click" />
                <ui:Button Content="›" FontSize="22" Padding="10,2" ToolTip="Next" Click="Next_Click" />
                <ComboBox x:Name="ViewModeBox" Width="110" Margin="12,0,0,0"
                          SelectionChanged="ViewMode_Changed">
                    <ComboBoxItem Content="Month" />
                    <ComboBoxItem Content="Week" />
                    <ComboBoxItem Content="Day" />
                </ComboBox>
                <ui:Button x:Name="RefreshButton" Margin="8,0,0,0" Content="Refresh" Click="Refresh_Click" />
            </StackPanel>
            <StackPanel>
                <TextBlock x:Name="RangeTitle" FontWeight="SemiBold" FontSize="16" />
                <TextBlock x:Name="TicketTitle" Opacity="0.75" />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="2" Margin="20,0,20,8" Padding="10,6" CornerRadius="5"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
            <DockPanel>
                <TextBlock x:Name="ResolutionText" DockPanel.Dock="Right" Opacity="0.65" />
                <TextBlock x:Name="StatusText" Opacity="0.75" Text="Loading Jira worklogs…" />
            </DockPanel>
        </Border>

        <Border Grid.Row="3" Margin="20,0,20,10" BorderThickness="1" CornerRadius="5"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" ClipToBounds="True">
            <Grid x:Name="SchedulerHost" Background="{DynamicResource ApplicationBackgroundBrush}" />
        </Border>

        <DockPanel Grid.Row="4" LastChildFill="False" Margin="20,0,20,18">
            <TextBlock x:Name="RangeTotal" VerticalAlignment="Center" FontWeight="SemiBold" />
            <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Opacity="0.6"
                       Text="Saved Jira worklogs are blue; pending local worklogs are amber." />
            <ui:Button DockPanel.Dock="Right" Content="Close" Click="Close_Click" />
        </DockPanel>
    </Grid>
</ui:FluentWindow>
