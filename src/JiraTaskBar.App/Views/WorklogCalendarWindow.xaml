<ui:FluentWindow x:Class="JiraTaskBar.App.Views.WorklogCalendarWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Time calendar"
                 Width="850" Height="560" MinWidth="700" MinHeight="440"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 Loaded="Window_Loaded" Closed="Window_Closed">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="WindowTitle" Title="Time calendar" />

        <DockPanel Grid.Row="1" Margin="20,8,20,12">
            <ui:Button x:Name="RefreshButton" DockPanel.Dock="Right" Content="Refresh" Click="Refresh_Click" />
            <StackPanel>
                <TextBlock x:Name="TicketTitle" FontWeight="SemiBold" FontSize="15" />
                <TextBlock x:Name="StatusText" Opacity="0.7" Text="Loading Jira worklogs…" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="2" Margin="20,0,20,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Calendar x:Name="DateCalendar" Margin="0,0,16,0" SelectionMode="SingleDate"
                      SelectedDatesChanged="Calendar_SelectedDatesChanged" />
            <GroupBox Grid.Column="1" x:Name="DayGroup" Header="Selected day">
                <DataGrid x:Name="WorklogGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="Auto" />
                        <DataGridTextColumn Header="Duration" Binding="{Binding Duration}" Width="Auto" />
                        <DataGridTextColumn Header="Author" Binding="{Binding Author}" Width="Auto" />
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="Auto" />
                        <DataGridTextColumn Header="Comment" Binding="{Binding Comment}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>
        </Grid>

        <DockPanel Grid.Row="3" LastChildFill="False" Margin="20,0,20,18">
            <TextBlock x:Name="DayTotal" VerticalAlignment="Center" FontWeight="SemiBold" />
            <ui:Button DockPanel.Dock="Right" Content="Close" Click="Close_Click" />
        </DockPanel>
    </Grid>
</ui:FluentWindow>
