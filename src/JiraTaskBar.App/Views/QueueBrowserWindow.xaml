<ui:FluentWindow x:Class="JiraTaskBar.App.Views.QueueBrowserWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Browse Jira queues" Width="850" Height="560" MinWidth="650" MinHeight="390"
                 WindowStartupLocation="CenterScreen" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica"
                 Loaded="Window_Loaded" Closed="Window_Closed">
    <DockPanel>
        <ui:TitleBar Title="Browse Jira queues" DockPanel.Dock="Top" />
        <StackPanel DockPanel.Dock="Top" Margin="16,8,16,8">
            <Label Content="_Source" Target="{Binding ElementName=SourceBox}" Padding="0" />
            <ComboBox x:Name="SourceBox" DisplayMemberPath="Label" SelectionChanged="Source_Changed" />
            <DockPanel x:Name="JqlPanel" Margin="0,8,0,0">
                <ui:Button DockPanel.Dock="Right" Content="Search" Margin="8,0,0,0" Click="Search_Click" />
                <ui:TextBox x:Name="JqlBox" AutomationProperties.Name="Jira query" KeyDown="Jql_KeyDown" />
            </DockPanel>
            <TextBlock x:Name="SourceStatus" Opacity="0.75" TextWrapping="Wrap" Margin="0,4,0,0" />
            <UniformGrid Rows="1" Margin="0,8,0,0">
                <ComboBox x:Name="ProjectBox" DisplayMemberPath="Label" SelectionChanged="Filter_Changed"
                          AutomationProperties.Name="Project filter" Margin="0,0,6,0" />
                <ComboBox x:Name="TypeBox" DisplayMemberPath="Label" SelectionChanged="Filter_Changed"
                          AutomationProperties.Name="Ticket type filter" Margin="0,0,6,0" />
                <ComboBox x:Name="StatusBox" DisplayMemberPath="Label" SelectionChanged="Filter_Changed"
                          AutomationProperties.Name="Status filter" Margin="0,0,6,0" />
                <ComboBox x:Name="PriorityBox" DisplayMemberPath="Label" SelectionChanged="Filter_Changed"
                          AutomationProperties.Name="Priority filter" Margin="0,0,6,0" />
                <ui:TextBox x:Name="TextFilter" PlaceholderText="Key or summary" TextChanged="TextFilter_Changed"
                            AutomationProperties.Name="Filter by key or summary" />
            </UniformGrid>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="16,6,16,12">
            <TextBlock x:Name="ResultsStatus" TextWrapping="Wrap" />
            <TextBlock x:Name="PinStatus" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <ui:Button Content="_Add to bar" Appearance="Primary" Click="Add_Click" />
                <ui:Button Content="Move pin _up" Click="MoveUp_Click" Margin="8,0,0,0" />
                <ui:Button Content="Move pin _down" Click="MoveDown_Click" Margin="8,0,0,0" />
            </StackPanel>
        </StackPanel>
        <DataGrid x:Name="TicketGrid" Margin="16,0" IsReadOnly="True" AutoGenerateColumns="False"
                  SelectionMode="Single" SelectionUnit="FullRow" PreviewMouseLeftButtonDown="Ticket_MouseDown"
                  PreviewMouseMove="Ticket_MouseMove" AutomationProperties.Name="Jira tickets">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Key" Binding="{Binding Issue.Key}" Width="100" />
                <DataGridTextColumn Header="Summary" Binding="{Binding Issue.Summary}" Width="*" />
                <DataGridTextColumn Header="Type" Binding="{Binding Issue.IssueType}" Width="100" />
                <DataGridTextColumn Header="Status" Binding="{Binding Issue.Status}" Width="110" />
                <DataGridTextColumn Header="Priority" Binding="{Binding Issue.Priority.Name}" Width="85" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</ui:FluentWindow>
