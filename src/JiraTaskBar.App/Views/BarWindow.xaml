<Window x:Class="JiraTaskBar.App.Views.BarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:JiraTaskBar.App.ViewModels"
        Title="Jira TaskBar"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        SizeToContent="Height"
        Width="148"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
        BorderThickness="1"
        UseLayoutRounding="True">

    <Window.Resources>
        <Style x:Key="TicketButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Appearance" Value="Secondary" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="6,4,8,4" />
            <Setter Property="MinHeight" Value="38" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="Appearance" Value="Primary" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsStale}" Value="True">
                    <Setter Property="Opacity" Value="0.6" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Issue type icon: Jira's own icon when loaded, otherwise a matching built-in glyph. -->
        <DataTemplate x:Key="TypeIconTemplate" DataType="{x:Type vm:TicketViewModel}">
            <Grid Width="16" Height="16" ToolTip="{Binding Issue.IssueType}">
                <Image Source="{Binding TypeIcon}" RenderOptions.BitmapScalingMode="HighQuality"
                       Visibility="{Binding HasTypeIcon, Converter={StaticResource BoolToVisibility}}" />
                <ui:SymbolIcon Symbol="{Binding TypeGlyph}" Foreground="{Binding TypeGlyphBrush}" FontSize="16"
                               Visibility="{Binding ShowTypeGlyph, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="TicketTemplate" DataType="{x:Type vm:TicketViewModel}">
            <Grid x:Name="Cell" Margin="3,2"
                  Width="{Binding DataContext.ButtonWidth, RelativeSource={RelativeSource AncestorType=Window}}">
                <ui:Button Style="{StaticResource TicketButtonStyle}" Command="{Binding ToggleCommand}">
                    <ui:Button.InputBindings>
                        <MouseBinding MouseAction="MiddleClick" Command="{Binding OpenInBrowserCommand}" />
                    </ui:Button.InputBindings>
                    <ui:Button.ContextMenu>
                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <MenuItem Header="Add comment…" Command="{Binding CommentCommand}" />
                            <Separator />
                            <MenuItem Header="Open in Jira" Command="{Binding OpenInBrowserCommand}" />
                        </ContextMenu>
                    </ui:Button.ContextMenu>
                    <ui:Button.ToolTip>
                        <ToolTip MaxWidth="380">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource TypeIconTemplate}"
                                                      Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock FontWeight="SemiBold" Text="{Binding Key}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Margin="0,2,0,0" Text="{Binding Summary}" TextWrapping="Wrap" />
                                <TextBlock Margin="0,4,0,0" Opacity="0.75" Text="{Binding MetaLine}" />
                                <TextBlock Margin="0,6,0,0" FontSize="11" Opacity="0.6"
                                           Text="Click: start/stop timer · Right-click: ticket menu · Middle-click: open in browser" />
                            </StackPanel>
                        </ToolTip>
                    </ui:Button.ToolTip>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="4" Margin="0,1,7,1" CornerRadius="2" Background="{Binding PriorityBrush}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <DockPanel>
                                <ContentPresenter DockPanel.Dock="Left" Content="{Binding}" ContentTemplate="{StaticResource TypeIconTemplate}"
                                                  Margin="0,0,5,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Key}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBlock Text="{Binding SubtitleText}" FontSize="11" Opacity="0.8" TextTrimming="CharacterEllipsis"
                                       Visibility="{Binding HasSubtitle, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </Grid>
                </ui:Button>
                <ui:Button x:Name="OpenButton"
                           Visibility="Hidden"
                           HorizontalAlignment="Right" VerticalAlignment="Top"
                           Margin="0,2,2,0" Padding="3" MinHeight="0" MinWidth="0"
                           Appearance="Transparent"
                           Icon="{ui:SymbolIcon Open16}"
                           ToolTip="Open in browser"
                           Command="{Binding OpenInBrowserCommand}" />
            </Grid>
            <DataTemplate.Triggers>
                <Trigger SourceName="Cell" Property="IsMouseOver" Value="True">
                    <Setter TargetName="OpenButton" Property="Visibility" Value="Visible" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <DockPanel x:Name="Root" LastChildFill="True">
        <!-- Drag handle: drag to move, drop near a screen edge to dock. -->
        <Border x:Name="Grip" DockPanel.Dock="Top" Height="16" Background="Transparent" Cursor="SizeAll"
                ToolTip="Drag to move · drop on a screen edge to dock"
                MouseLeftButtonDown="Grip_MouseLeftButtonDown"
                MouseMove="Grip_MouseMove"
                MouseLeftButtonUp="Grip_MouseLeftButtonUp"
                LostMouseCapture="Grip_LostMouseCapture">
            <ui:SymbolIcon x:Name="GripIcon" Symbol="ReOrderDotsHorizontal24" FontSize="14" Opacity="0.55"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>

        <StackPanel x:Name="Footer" DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center" Margin="2">
            <ui:Button Appearance="Transparent" Padding="5" MinWidth="0" MinHeight="0"
                       Icon="{ui:SymbolIcon Warning24}" Foreground="#F5A623"
                       Visibility="{Binding HasPending, Converter={StaticResource BoolToVisibility}}"
                       ToolTip="{Binding PendingTooltip}"
                       Click="Pending_Click" />
            <ui:Button Appearance="Transparent" Padding="5" MinWidth="0" MinHeight="0"
                       Icon="{ui:SymbolIcon ArrowSync24}" ToolTip="Refresh tickets"
                       Command="{Binding RefreshCommand}" />
            <ui:Button x:Name="MenuButton" Appearance="Transparent" Padding="5" MinWidth="0" MinHeight="0"
                       Icon="{ui:SymbolIcon MoreHorizontal24}" ToolTip="Menu"
                       Click="MenuButton_Click" />
        </StackPanel>

        <Grid>
            <TextBlock Margin="8" TextWrapping="Wrap" FontSize="12" Opacity="0.75" TextAlignment="Center"
                       VerticalAlignment="Center"
                       Text="{Binding EmptyText}"
                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
            <ScrollViewer x:Name="Scroller"
                          VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollBarVisibility="Disabled"
                          PanningMode="Both"
                          PreviewMouseWheel="Scroller_PreviewMouseWheel">
                <ItemsControl ItemsSource="{Binding Tickets}" ItemTemplate="{StaticResource TicketTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="{Binding DataContext.Orientation, RelativeSource={RelativeSource AncestorType=Window}}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
