<ui:FluentWindow x:Class="JiraTaskBar.App.Views.CommentWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
                 xmlns:local="clr-namespace:JiraTaskBar.App.Views"
                 Title="Comment"
                 Width="680" Height="540" MinWidth="480" MinHeight="360"
                 ShowInTaskbar="True"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">
    <ui:FluentWindow.InputBindings>
        <KeyBinding Modifiers="Control" Key="Return" Command="{x:Static local:CommentWindow.PostCommand}" />
        <KeyBinding Key="Escape" Command="{x:Static local:CommentWindow.CancelCommand}" />
    </ui:FluentWindow.InputBindings>

    <ui:FluentWindow.Resources>
        <Style x:Key="ToolButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Appearance" Value="Transparent" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="Focusable" Value="False" />
        </Style>
        <Style x:Key="ToolSeparator" TargetType="Border">
            <Setter Property="Width" Value="1" />
            <Setter Property="Margin" Value="4,6" />
            <Setter Property="Background" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="TitleBarControl" Title="Comment" ShowMaximize="True" ShowMinimize="True" />

        <StackPanel Grid.Row="1" Margin="16,0,16,6">
            <TextBlock x:Name="IssueKeyText" FontWeight="SemiBold" FontSize="15" />
            <TextBlock x:Name="IssueSummaryText" Opacity="0.75" TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <!-- Formatting toolbar: inserts Jira wiki markup. -->
        <WrapPanel Grid.Row="2" Margin="12,0,12,4">
            <ui:Button Style="{StaticResource ToolButton}" Icon="{ui:SymbolIcon TextBold24}" ToolTip="Bold  *text*  (Ctrl+B)" Click="Bold_Click" />
            <ui:Button Style="{StaticResource ToolButton}" Icon="{ui:SymbolIcon TextItalic24}" ToolTip="Italic  _text_  (Ctrl+I)" Click="Italic_Click" />
            <ui:Button Style="{StaticResource ToolButton}" Icon="{ui:SymbolIcon TextUnderline24}" ToolTip="Underline  +text+  (Ctrl+U)" Click="Underline_Click" />
            <ui:Button Style="{StaticResource ToolButton}" Icon="{ui:SymbolIcon TextStrikethrough24}" ToolTip="Strikethrough  -text-" Click="Strike_Click" />
            <Border Style="{StaticResource ToolSeparator}" />
            <ui:Button Style="{StaticResource ToolButton}" Icon="{ui:SymbolIcon TextHeader224}" ToolTip="Heading  h3." Click="Heading_Click" />
            <ui:Button Style="{StaticResource ToolButton}" Icon="{ui:SymbolIcon TextBulletListLtr24}" ToolTip="Bullet list  *" Click="Bullets_Click" />
            <ui:Button Style="{StaticResource ToolButton}" Icon="{ui:SymbolIcon TextNumberListLtr24}" ToolTip="Numbered list  #" Click="Numbers_Click" />
            <ui:Button Style="{StaticResource ToolButton}" Icon="{ui:SymbolIcon TextQuote24}" ToolTip="Quote  bq." Click="Quote_Click" />
            <Border Style="{StaticResource ToolSeparator}" />
            <ui:Button Style="{StaticResource ToolButton}" Icon="{ui:SymbolIcon Code24}" ToolTip="Inline code  {{text}}" Click="InlineCode_Click" />
            <ui:Button Style="{StaticResource ToolButton}" Icon="{ui:SymbolIcon CodeBlock24}" ToolTip="Code block  {code}" Click="CodeBlock_Click" />
            <ui:Button Style="{StaticResource ToolButton}" Icon="{ui:SymbolIcon Link24}" ToolTip="Link  [text|url]  (Ctrl+K)" Click="Link_Click" />
            <Border Style="{StaticResource ToolSeparator}" />
            <ui:Button x:Name="TableButton" Style="{StaticResource ToolButton}" Icon="{ui:SymbolIcon TableAdd24}" ToolTip="Insert table" Click="Table_Click" />
            <ui:Button Style="{StaticResource ToolButton}" Icon="{ui:SymbolIcon ImageAdd24}" ToolTip="Insert image (you can also paste or drop images)" Click="Image_Click" />
            <ui:Button Style="{StaticResource ToolButton}" Icon="{ui:SymbolIcon Attach24}" ToolTip="Attach file" Click="Attach_Click" />
        </WrapPanel>

        <Popup x:Name="TablePopup" PlacementTarget="{Binding ElementName=TableButton}" Placement="Bottom"
               StaysOpen="False" AllowsTransparency="True">
            <Border Background="{DynamicResource ApplicationBackgroundBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="8">
                <StackPanel>
                    <UniformGrid x:Name="TableGrid" Rows="8" Columns="8" />
                    <TextBlock x:Name="TableSizeText" Margin="0,6,0,0" HorizontalAlignment="Center" Text="Header row + 1 × 1" />
                </StackPanel>
            </Border>
        </Popup>

        <TabControl x:Name="Tabs" Grid.Row="3" Margin="12,0,12,6" SelectionChanged="Tabs_SelectionChanged">
            <TabItem Header="Write">
                <TextBox x:Name="Editor"
                         AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         VerticalContentAlignment="Top"
                         FontFamily="Cascadia Mono, Consolas" FontSize="13"
                         AllowDrop="True"
                         PreviewDragOver="Editor_PreviewDragOver"
                         PreviewDrop="Editor_PreviewDrop"
                         PreviewKeyDown="Editor_PreviewKeyDown" />
            </TabItem>
            <TabItem Header="Preview">
                <Grid>
                    <wv2:WebView2 x:Name="PreviewView" />
                    <TextBlock x:Name="PreviewFallback" Visibility="Collapsed" Margin="12" TextWrapping="Wrap" Opacity="0.75" />
                </Grid>
            </TabItem>
        </TabControl>

        <ItemsControl x:Name="AttachmentList" Grid.Row="4" Margin="12,0,12,4">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type local:PendingAttachment}">
                    <Border Margin="0,0,6,4" Padding="8,2,2,2" CornerRadius="12"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Icon}" Margin="0,0,4,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding FileName}" VerticalAlignment="Center" FontSize="12" />
                            <ui:Button Appearance="Transparent" Padding="3" MinWidth="0" MinHeight="0" Margin="4,0,0,0"
                                       Icon="{ui:SymbolIcon Dismiss24}" FontSize="10" ToolTip="Remove attachment"
                                       Tag="{Binding}" Click="RemoveAttachment_Click" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Grid.Row="5">
        <!-- Shown while "Reply to customer" is selected, so a public reply is never a surprise. -->
        <ui:InfoBar x:Name="PublicBanner" Margin="12,2,12,0" IsOpen="False" IsClosable="False" Severity="Warning"
                    Title="Reply to customer"
                    Message="This comment will be visible on the customer portal and emailed to the customer." />
        <DockPanel Margin="16,4,16,14" LastChildFill="True">
            <StackPanel x:Name="VisibilityPanel" DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                <RadioButton x:Name="InternalRadio" Content="Internal note" GroupName="Visibility" IsChecked="True" Margin="0,0,12,0"
                             ToolTip="Only visible to your team" Checked="Visibility_Changed" />
                <RadioButton x:Name="PublicRadio" Content="Reply to customer" GroupName="Visibility"
                             ToolTip="Visible to the customer on the portal and sent by email" Checked="Visibility_Changed" />
            </StackPanel>
            <ui:Button DockPanel.Dock="Right" x:Name="PostButton" Appearance="Primary" Icon="{ui:SymbolIcon Send24}"
                       Content="Post" Margin="8,0,0,0" ToolTip="Post comment (Ctrl+Enter)" Click="Post_Click" />
            <ui:Button DockPanel.Dock="Right" Content="Cancel" Click="Cancel_Click" />
            <TextBlock x:Name="StatusText" Margin="12,0" VerticalAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
        </DockPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
