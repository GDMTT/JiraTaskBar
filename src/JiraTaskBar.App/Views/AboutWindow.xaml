<ui:FluentWindow x:Class="JiraTaskBar.App.Views.AboutWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="About Jira TaskBar" Width="430" SizeToContent="Height" ResizeMode="NoResize"
                 WindowStartupLocation="CenterScreen" ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica" WindowCornerPreference="Round">
    <StackPanel>
        <ui:TitleBar Title="About Jira TaskBar" ShowMinimize="False" ShowMaximize="False" />
        <StackPanel Margin="24,14,24,22">
            <TextBlock x:Name="ProductName" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="Created by Gregory Machin" Margin="0,4,0,12" />
            <TextBlock x:Name="ReleaseVersion" Margin="0,0,0,4" />
            <TextBlock x:Name="BuildTime" Margin="0,0,0,4" />
            <TextBlock Text="License: GNU General Public License v3.0 only (GPL-3.0-only)" TextWrapping="Wrap" />
            <TextBlock Margin="0,12,0,0">
                <Hyperlink Click="Repository_Click">GitHub repository</Hyperlink>
            </TextBlock>
            <ui:Button Content="Close" HorizontalAlignment="Right" Margin="0,16,0,0" Click="Close_Click" />
        </StackPanel>
    </StackPanel>
</ui:FluentWindow>
