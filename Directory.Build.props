<Project>
  <!-- Supply-chain settings for every project (see docs/THREAT_MODEL.md, E2). -->
  <PropertyGroup>
    <!-- Pin exact package versions + hashes in packages.lock.json; CI builds refuse to drift. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(ContinuousIntegrationBuild)' == 'true'">true</RestoreLockedMode>

    <!--
      Releases are published as a win-x64 single-file exe (build/publish.ps1). Publishing adds the
      runtime identifier and the single-file analyzer (Microsoft.NET.ILLink.Tasks) to restore, so
      declare both for every build: the lock files then match normal builds and release publishes.
    -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>

    <!-- Check direct and transitive packages against the GitHub Advisory Database on restore. -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
    <!-- High (NU1903) and critical (NU1904) advisories fail the build; low/moderate stay warnings. -->
    <WarningsAsErrors>$(WarningsAsErrors);NU1903;NU1904</WarningsAsErrors>
  </PropertyGroup>
</Project>
